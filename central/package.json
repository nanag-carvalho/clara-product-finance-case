{
  "name": "clara-case-central",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "sync:research": "node scripts/sync-research.mjs",
    "predev": "npm run sync:research && npm run ds:generate",
    "prebuild": "npm run sync:research && npm run ds:generate && npm run ds:check && npm run ds:registry",
    "ds:generate": "node scripts/generate-ds.mjs",
    "ds:check": "node scripts/generate-ds.mjs --check && node scripts/check-ds.mjs",
    "ds:registry": "npx shadcn@4.21.4 build --output public/r"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
