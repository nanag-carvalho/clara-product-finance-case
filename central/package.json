{
  "name": "clara-case-central",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "sync:research": "node scripts/sync-research.mjs",
    "predev": "npm run sync:research && npm run ds:generate",
    "prebuild": "npm run sync:research && npm run ds:generate && npm run ds:check && npm run ds:registry",
    "ds:generate": "node scripts/generate-ds.mjs",
    "ds:check": "node scripts/generate-ds.mjs --check && node scripts/check-ds.mjs",
    "ds:registry": "node scripts/build-registry.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests scripts vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests scripts vite.config.ts playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "verify:full": "npm run verify && npm run test:e2e",
    "pretypecheck": "npm run sync:research && npm run ds:generate"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "postcss": "^8.5.6",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
